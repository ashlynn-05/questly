      "variant": "emphasis"
    },
    {
      "id": "candidates-to-shortlist",
      "from": "candidates",
      "to": "shortlist",
      "label": "base score",
      "classification": "sorted"
    },
    {
      "id": "shortlist-to-openai",
      "from": "shortlist",
      "to": "openai",
      "label": "15 titles and blurbs",
      "classification": "embedMany, one call"
    },
    {
      "id": "openai-to-questvectors",
      "from": "openai",
      "to": "questvectors",
      "label": "15 vectors",
      "classification": "request order restored"
    },
    {
      "id": "questvectors-to-deck",
      "from": "questvectors",
      "to": "deck",
      "label": "cosine at weight 1.1",
      "classification": "re-sorted",
      "labelDx": -40
    },
    {
      "id": "untasted-fallback",
      "from": "shortlist",
      "to": "deck",
      "label": "untasted order kept",
      "classification": "no vector or provider down",
      "variant": "dashed",
      "route": "bottom-channel"
    }
