  "cards": [
    {
      "dot": "cyan",
      "title": "Client and PWA",
      "items": [
        "Next.js 16 App Router, React 19, Tailwind v4",
        "Service worker serves /offline and takes pushes",
        "Guests join by four-digit code, no account"
      ]
    },
    {
      "dot": "emerald",
      "title": "The one subscription",
      "items": [
        "Every room screen runs on a single reactive query",
        "It reads the caller's own swipes, not the room's",
        "A backfill on the migrations component seeded the counts"
      ]
    },
    {
      "dot": "violet",
      "title": "Queues and quota",
      "items": [
        "Two pools, parallelism 8, retries off",
        "Plan duplicates die at execution under a lease",
        "One stored vector per venue, so a borrowed deck is free"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Next holds no auth secret",
        "Guests carry a sessionKey, not an identity",
        "Provider and VAPID keys stay in the deployment"
      ]
    }
  ]
