# ---------------------------------------------------------------------------
# Next.js env (.env.local). Public values only -- anything here reaches the browser
# if prefixed NEXT_PUBLIC_. Real secrets live in the Convex deployment env instead,
# because Better Auth, the Places call and the OpenAI call all run inside Convex.
# ---------------------------------------------------------------------------

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Same subdomain as NEXT_PUBLIC_CONVEX_URL but ending .site instead of .cloud
NEXT_PUBLIC_CONVEX_SITE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Draws the plan screen's route map. Needs the MAPS EMBED API enabled (SKU
# 9C10-8313-F21F, unlimited at no charge) and an HTTP referrer restriction.
# Public by design -- NEXT_PUBLIC_ ships it in the browser bundle, which is
# exactly why GOOGLE_MAPS_SERVER_KEY below must never be reused here.
# Optional: without it the plan renders without the map and nothing else breaks.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Unused by the current source. A Cloud-configured Map ID for the Maps JS SDK,
# which this product does not load -- see .docs/setup.md.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------------
# Convex deployment env -- NOT this file. Set with `npx convex env set <NAME> <value>`
#
#   BETTER_AUTH_SECRET      openssl rand -base64 32
#   SITE_URL                http://localhost:3000
#   GOOGLE_CLIENT_ID        OAuth client (Google Cloud Console)
#   GOOGLE_CLIENT_SECRET
#   DISCORD_CLIENT_ID       OAuth app (Discord Developer Portal)
#   DISCORD_CLIENT_SECRET
#   GOOGLE_MAPS_SERVER_KEY  Places API key, no referrer restriction
#   OPENAI_API_KEY
#
#   VAPID_PUBLIC_KEY        npx web-push generate-vapid-keys
#   VAPID_PRIVATE_KEY       the other half of the same pair
#
# Both halves of the VAPID pair live in the Convex deployment env, never here
# and never in the repository. The public half is served to the browser by
# `api.push.publicKey` rather than baked in as a NEXT_PUBLIC_ variable, so the
# pair is set and rotated in one place. With neither set, push self-disables:
# the settings screen says so and nothing is ever sent.
# ---------------------------------------------------------------------------
